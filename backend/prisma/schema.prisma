generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Unidade {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  nome        String     @unique // Ex: 1º BPM, BOPE, CME
  sigla       String?
  coint       String?
  localizacao String?
  contato     String?
  militares Militar[]
  cautelas  Cautela[]
  // Rádios podem pertencer a uma unidade
  radios    Equipamento[]
  manutencoesVTR ManutencaoVTR[]
  transferenciasEnviadas   Transferencia[] @relation("origem")
  transferenciasRecebidas  Transferencia[] @relation("destino")
  extravios Extravio[]
}

model Militar {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  rg        String?    
  cpf       String?
  contato   String?    
  posto     String?    // Ex: SD, CB, SGT, TEN
  unidadeId String     @db.ObjectId
  unidade   Unidade    @relation(fields: [unidadeId], references: [id])
  cautelas  Cautela[]
  extravios Extravio[]
  transferencias Transferencia[]
}

enum TipoEquipamento {
  RADIO
  DIVERSO
}

model Equipamento {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  idRadio     String?   // "ID do Rádio" (não é mais único para aceitar vários vazios)
  rp          String?   // Número de Patrimônio (não é mais único para aceitar vários vazios)
  numSerie    String    @unique // Número de Série (Garante a unicidade real)
  marca       String?   // Motorola, Tait
  modelo      String?   // APX 900, APX 2000, TP9400, TP9100
  garantia    String    @default("Não")
  status      StatusEquipamento @default(OPERACIONAL)
  tipo        TipoEquipamento   @default(RADIO)
  
  // Campos de Laudo Técnico vinculados ao rádio
  problema       String?
  solicitante    String?
  paeNumero      String?
  analiseTecnica String?
  laudoTecnico   String?
  tecnicoResp    String?
  dataEntradaLaudo DateTime?
  dataSaidaLaudo   DateTime?
  
  unidadeId   String?   @db.ObjectId
  unidade     Unidade?  @relation(fields: [unidadeId], references: [id])
  
  cautelaIds  String[]  @db.ObjectId
  cautelas    Cautela[] @relation(fields: [cautelaIds], references: [id])
  
  manutencoes Manutencao[]
  extravios   Extravio[]
  
  transferenciaIds String[]        @db.ObjectId
  transferencias   Transferencia[] @relation(fields: [transferenciaIds], references: [id])
}

enum StatusEquipamento {
  OPERACIONAL
  CAUTELADO
  MANUTENCAO
  EXTRAVIADO
  BAIXADO
  TRANSFERIDO
  LAUDO
}

model Cautela {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  numeroSequencial Int?        // Número amigável (1, 2, 3...)
  
  equipamentoIds String[]     @db.ObjectId
  equipamentos   Equipamento[] @relation(fields: [equipamentoIds], references: [id])
  
  militarId     String?       @db.ObjectId
  militar       Militar?      @relation(fields: [militarId], references: [id])
  
  unidadeId     String?       @db.ObjectId
  unidade       Unidade?      @relation(fields: [unidadeId], references: [id])
  
  missao        String?
  dataRetirada  DateTime    @default(now())
  dataDevolucao DateTime?   // Quando foi devolvido
  dataPrevista  DateTime?   // Data limite para devolução (ex: evento sábado)
  
  // Dados do militar que recebe o rádio (inseridos manualmente)
  recebedorPosto   String?
  recebedorRgPM    String?
  recebedorNome    String?
  recebedorGuerra  String?
  recebedorContato String?
  
  status        StatusCautela @default(ATIVA) // ATIVA, DEVOLVIDA, VENCIDA
}

enum StatusCautela {
  ATIVA
  DEVOLVIDA
  VENCIDA
}

model Usuario {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nomeCompleto String
  nomeGuerra   String
  email        String   @unique
  senha        String
  posto        String?  // Ex: 1º Sargento
  unidade      String?  // Ex: DITEL (Texto livre por enquanto)
  permissao    String   @default("Administrador") 
  dataCadastro DateTime @default(now())
}

model Manutencao {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  equipamentoId   String      @db.ObjectId
  equipamento     Equipamento @relation(fields: [equipamentoId], references: [id])
  problema        String
  dataEntrada     DateTime    @default(now())
  dataChegadaDitel DateTime?
  dataSaidaEmpresa DateTime?
  previsaoRetorno DateTime?
  dataEnvioUnidade DateTime?
  dataConclusao   DateTime?
  status          String      @default("EM ANDAMENTO") // EM ANDAMENTO, CONCLUIDA
  
  // Campos de Laudo / Serviço
  analiseTecnica  String?
  laudoTecnico    String?
  tecnicoResp     String?
  solicitante     String?
  paeNumero       String?
}

model Extravio {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  equipamentoId String      @db.ObjectId
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
  militarId     String?     @db.ObjectId
  militar       Militar?    @relation(fields: [militarId], references: [id])
  dataExtravio  DateTime    @default(now())
  boNumero      String?     // Número do B.O
  local         String?
  descricao     String
  status        String      @default("INVESTIGACAO") // INVESTIGACAO, LOCALIZADO, BAIXADO
  
  // Dados do militar responsável pelo rádio (inseridos manualmente)
  militarResponsavelNome    String?
  militarResponsavelGuerra  String?
  militarResponsavelRg      String?
  militarResponsavelPatente String?
  militarResponsavelContato String?
  
  unidadeId                 String?   @db.ObjectId
  unidade                   Unidade?  @relation(fields: [unidadeId], references: [id])
}

model Transferencia {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  
  unidadeOrigemId   String?     @db.ObjectId
  unidadeOrigem     Unidade?    @relation("origem", fields: [unidadeOrigemId], references: [id])
  
  unidadeDestinoId  String      @db.ObjectId
  unidadeDestino    Unidade     @relation("destino", fields: [unidadeDestinoId], references: [id])
  
  dataTransferencia DateTime    @default(now())
  observacoes       String?
  qtdRadios         Int
  
  equipamentoIds    String[]    @db.ObjectId
  equipamentos      Equipamento[] @relation(fields: [equipamentoIds], references: [id])
  
  status            String      @default("FINALIZADA")
  
  militarId         String?     @db.ObjectId
  militar           Militar?    @relation(fields: [militarId], references: [id])
}

model Auditoria {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario     String   // Nome do usuário ou 'Sistema'
  acao        String   // O que foi feito
  detalhes    String?  // Opcional, como JSON ou IDs
  dataHora    DateTime @default(now())
}

model ManutencaoVTR {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  osNumero          Int?     // Numeração sequencial (OS)
  paeNumero         String?
  dataServico       DateTime @default(now())
  
  unidadeId         String?   @db.ObjectId
  unidade           Unidade?  @relation(fields: [unidadeId], references: [id])
  
  solicitante       String?
  tecnico           String?
  
  placaVrt          String?
  prefixo           String?
  kmVrt             Int?
  
  modeloRadio       String?
  numSerieRadio     String?
  
  defeitoReclamado  String?
  defeitoConstatado String?
  solucao           String?
  status            String    @default("Pendente") // Pronto, Pendente, Assistência Técnica
  
  servicos          String[]
  
  dataCriacao       DateTime @default(now())
}
