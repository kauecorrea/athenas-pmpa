generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Unidade {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  nome        String     @unique // Ex: 1º BPM, BOPE, CME
  sigla       String?
  coint       String?
  localizacao String?
  militares Militar[]
  cautelas  Cautela[]
  // Rádios podem pertencer a uma unidade
  radios    Equipamento[]
}

model Militar {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  nome      String
  rg        String?    
  cpf       String?
  contato   String?    
  posto     String?    // Ex: SD, CB, SGT, TEN
  unidadeId String     @db.ObjectId
  unidade   Unidade    @relation(fields: [unidadeId], references: [id])
  cautelas  Cautela[]
  extravios Extravio[]
  transferencias Transferencia[]
}

model Equipamento {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  idRadio     String?   @unique // "ID do Rádio" que aparece na interface
  rp          String    @unique // Número de Patrimônio
  numSerie    String    @unique // Número de Série
  marca       String?   // Motorola, Tait
  modelo      String?   // APX 900, APX 2000, TP9400, TP9100
  status      StatusEquipamento @default(OPERACIONAL)
  
  unidadeId   String?   @db.ObjectId
  unidade     Unidade?  @relation(fields: [unidadeId], references: [id])
  
  cautelaIds  String[]  @db.ObjectId
  cautelas    Cautela[] @relation(fields: [cautelaIds], references: [id])
  
  manutencoes Manutencao[]
  extravios   Extravio[]
  
  transferenciaIds String[]        @db.ObjectId
  transferencias   Transferencia[] @relation(fields: [transferenciaIds], references: [id])
}

enum StatusEquipamento {
  OPERACIONAL
  CAUTELADO
  MANUTENCAO
  EXTRAVIADO
  BAIXADO
  TRANSFERIDO
}

model Cautela {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  
  equipamentoIds String[]     @db.ObjectId
  equipamentos   Equipamento[] @relation(fields: [equipamentoIds], references: [id])
  
  militarId     String?       @db.ObjectId
  militar       Militar?      @relation(fields: [militarId], references: [id])
  
  unidadeId     String?       @db.ObjectId
  unidade       Unidade?      @relation(fields: [unidadeId], references: [id])
  
  missao        String?
  dataRetirada  DateTime    @default(now())
  dataDevolucao DateTime?   // Quando foi devolvido
  dataPrevista  DateTime?   // Data limite para devolução (ex: evento sábado)
  
  status        StatusCautela @default(ATIVA) // ATIVA, DEVOLVIDA, VENCIDA
}

enum StatusCautela {
  ATIVA
  DEVOLVIDA
  VENCIDA
}

model Usuario {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nomeCompleto String
  nomeGuerra   String
  email        String   @unique
  senha        String
  posto        String?  // Ex: 1º Sargento
  unidade      String?  // Ex: DITEL (Texto livre por enquanto)
  permissao    String   @default("Administrador") 
  dataCadastro DateTime @default(now())
}

model Manutencao {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  equipamentoId   String      @db.ObjectId
  equipamento     Equipamento @relation(fields: [equipamentoId], references: [id])
  problema        String
  dataEntrada     DateTime    @default(now())
  previsaoRetorno DateTime?
  dataConclusao   DateTime?
  status          String      @default("EM ANDAMENTO") // EM ANDAMENTO, CONCLUIDA
}

model Extravio {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  equipamentoId String      @db.ObjectId
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id])
  militarId     String?     @db.ObjectId
  militar       Militar?    @relation(fields: [militarId], references: [id])
  dataExtravio  DateTime    @default(now())
  local         String?
  descricao     String
  status        String      @default("INVESTIGACAO") // INVESTIGACAO, LOCALIZADO, BAIXADO
}

model Transferencia {
  id                String      @id @default(auto()) @map("_id") @db.ObjectId
  militarId         String      @db.ObjectId
  militar           Militar     @relation(fields: [militarId], references: [id])
  destino           String
  dataTransferencia DateTime    @default(now())
  observacoes       String?
  qtdRadios         Int
  
  equipamentoIds    String[]    @db.ObjectId
  equipamentos      Equipamento[] @relation(fields: [equipamentoIds], references: [id])
  
  status            String      @default("FINALIZADA")
}

model Auditoria {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario     String   // Nome do usuário ou 'Sistema'
  acao        String   // O que foi feito
  detalhes    String?  // Opcional, como JSON ou IDs
  dataHora    DateTime @default(now())
}
