# Configurações do Banco de Dados (MongoDB)
# Substitua a string abaixo pela URI do seu cluster em Produção
DATABASE_URL="mongodb://localhost:27017/athenas"

# Chave Secreta para Geração de Tokens JWT
# Utilize uma string forte, longa e aleatória em produção
JWT_SECRET="super-senha-secreta-athenas-dev-local"

# Porta do Servidor Node.js (Opcional, padrão é 3333 se vazio)
PORT=3333

# (Opcional) URL Externa do Sistema para Keep-Alive Automático
# RENDER_EXTERNAL_URL="https://seu-sistema-no-render.com"
